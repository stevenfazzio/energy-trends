{
 "id": "energy-per-gdp",
 "title": "Energy consumed per unit of economic output",
 "description": "Kilowatt-hours per international dollar of GDP \u2014 how much energy it takes to produce a unit of economic activity.",
 "group": "throughput",
 "sources": [
  {
   "name": "Our World in Data \u2014 Energy dataset",
